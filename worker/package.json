  },
  "dependencies": {
    "hono": "^4.12.33",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250509.0",
    "@tailwindcss/typography": "^0.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  }
}
